COMPOSE_PROJECT_NAME=reconciliation-agent

# Host port exposed by the frontend nginx container.
# Point host-level nginx to http://127.0.0.1:8080.
WEB_PORT=8080

# Keep empty in Docker production so the Vue app calls same-origin /api/...
VITE_API_BASE_URL=

# Production default: use DeepSeek for both preview analysis and product mapping.
PREVIEW_LLM_PROVIDER=deepseek
PREVIEW_LLM_MODEL=deepseek-chat
PREVIEW_LLM_BASE_URL=https://api.deepseek.com
PREVIEW_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

MAPPING_LLM_PROVIDER=deepseek
MAPPING_LLM_MODEL=deepseek-v4-flash
MAPPING_LLM_BASE_URL=https://api.deepseek.com
MAPPING_LLM_API_KEY_ENV=DEEPSEEK_API_KEY

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-key
